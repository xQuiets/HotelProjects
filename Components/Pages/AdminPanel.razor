@page "/admin"
@rendermode InteractiveServer
@using HotelProject.Services
@using HotelProject.Models
@inject PanelService Panel
@inject AuthService Auth
@inject NavigationManager Nav

<h2>Управление пользователями</h2>

@if (!string.IsNullOrEmpty(message))
{
    <p style="color: @(isError ? "red" : "green");">@message</p>
}

<h4>Добавить нового пользователя</h4>

<div>
    <input @bind="newLogin" placeholder="Логин" />
    <input @bind="newPassword" type="password" placeholder="Пароль" />

    <select @bind="newRole">
        <option value="User">Пользователь</option>
        <option value="Admin">Администратор</option>
    </select>

    <button @onclick="AddUser">Добавить</button>
</div>

<br />

<table border="1" cellpadding="5" cellspacing="0">
    <thead>
        <tr>
            <th>ID</th>
            <th>Логин</th>
            <th>Роль</th>
            <th>Статус</th>
            <th>Действие</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in users) //проходимся по списку всех юзеров
        {
            <tr>
                <td>@user.IdUser</td>
                <td>@user.Login</td>
                <td>@user.Role</td>
                <td>@(user.IsBlocked == true ? "Заблокирован" : "Активен")</td>
                <td>
                    @if (user.IsBlocked == true)
                    {
                        <button @onclick="() => Unblock(user.IdUser)">Разблокировать</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<br />

<button @onclick="Logout">Выйти</button> // кнопка выхода

@code {
    //список для хранения юзеров
    private List<User> users = new();
    //переменные для полей ввода
    private string newLogin = "";
    private string newPassword = "";
    private string newRole = "User"; //по умолчанию пользователь
    //переменные для сообщений
    private string message = "";
    private bool isError = false;

    //вызывается при загрузке страницы
    protected override async Task OnInitializedAsync()
    {
        await LoadUsers(); //сразу загружаем список
    }
    //метод для загрузки всех пользователей из базы
    private async Task LoadUsers()
    {
        users = await Panel.GetAllUsersAsync(); //берем данные через сервис
    }
    //метод для добавления юзера
    private async Task AddUser()
    {
        //проверяем что поля не пустые
        if (string.IsNullOrWhiteSpace(newLogin) || string.IsNullOrWhiteSpace(newPassword))
        {
            message = "Заполните логин и пароль";
            isError = true;
            return;
        }
        //вызываем сервис для добавления
        var (success, msg) = await Panel.AddUserAsync(newLogin, newPassword, newRole);
        message = msg; //сохраняем сообщение
        isError = !success; //если не успех - значит ошибка
        //если все ок - очищаем поля и обновляем таблицу
        if (success)
        {
            newLogin = "";
            newPassword = "";
            await LoadUsers();
        }
    }
    //метод для разблокировки юзера
    private async Task Unblock(int userId)
    {
        await Panel.UnblockUserAsync(userId); //вызываем сервис
        message = "Пользователь разблокирован"; //пишем сообщение
        isError = false;
        await LoadUsers(); //обновляем таблицу
    }
    //метод для выхода
    private async Task Logout()
    {
        //Выход оставляем через Auth
        await Auth.LogoutAsync(); //чистим сессию
        Nav.NavigateTo("/login"); //перекидываем на страницу входа
    }
}