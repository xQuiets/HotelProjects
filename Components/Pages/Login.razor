@page "/login"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using HotelProject.Services
@using HotelProject.Components.Shared
@inject AuthService Auth
@inject NavigationManager Nav

<!--по центру экрана-->
<div style="display: flex; justify-content: center; margin-top: 50px;">

    <!--вертикальный блок-->
    <div style="text-align: center; display: flex; flex-direction: column;">
        <h3>Авторизация</h3>

        <!--вывод сообщений об ошибках или успехе-->
        @if (!string.IsNullOrEmpty(message))
        {
            <div style="color:@(isError ? "red" : "green"); margin-bottom: 15px; font-weight: bold;">
                @message
            </div>
        }

        <!--Форма входа-->
        <EditForm Model="loginModel" OnValidSubmit="HandleLogin" FormName="LoginForm">
            <DataAnnotationsValidator />
            <p style="text-align: left;">
                Логин:<br />
                <InputText @bind-Value="loginModel.Login" style="width: 100%; padding: 5px;" />
                <ValidationMessage For="() => loginModel.Login" style="color: red; font-size: 0.8em;" />
            </p>
            <p style="text-align: left;">
                Пароль:<br />
                <InputText @bind-Value="loginModel.Password" type="password" style="width: 100%; padding: 5px;" />
                <ValidationMessage For="() => loginModel.Password" style="color: red; font-size: 0.8em;" />
            </p>
            <button type="submit" style="width: 100%; padding: 8px;background: #555; color: white; border: none;cursor: pointer;">
                Войти
            </button>
        </EditForm>

        <!--Капча под кнопкой-->
        <div style="margin-top: 20px;">
            <Captcha @ref="captchaComponent" OnSolved="OnCaptchaSolved" />
        </div>
    </div>
</div>

@code {
    //Модель для формы (логин и пароль)
    private LoginModel loginModel = new();

    private bool isCaptchaSolved = false; //пройдена ли капча
    private bool isError = true; //флаг ошибки (для цвета текста)
    private string message = ""; //текст сообщения
    private Captcha? captchaComponent; //ссылка на компонент капчи, чтобы можно было ее сбросить

    //Вызывается, когда пользователь собрал пазл
    private void OnCaptchaSolved()
    {
        isCaptchaSolved = true;
        message = "Капча пройдена!";
        isError = false;
        StateHasChanged();
    }

    //Вызывается при нажатии на кнопку войти
    private async Task HandleLogin()
    {
        message = null;

        //Проверяем, пройдена ли капча
        if (!isCaptchaSolved)
        {
            message = "Пройдите капчу!";
            isError = true;
            return;
        }
        var (user, error) = await Auth.AuthenticateAsync(loginModel.Login, loginModel.Password);

        if (user == null) //если неверные данные
        {
            message = error!;
            isError = true;

            //Сбрасываем пазл при ошибке
            isCaptchaSolved = false;
            captchaComponent?.ResetPuzzle();
            return;
        }
        isError = false;
        Nav.NavigateTo("/"); //переходим на главную (она перекинет по роли)
    }

    //Класс модели с правилами проверки полей
    public class LoginModel
    {
        [Required(ErrorMessage = "Введите логин")]
        public string Login { get; set; } = "";

        [Required(ErrorMessage = "Введите пароль")]
        public string Password { get; set; } = "";
    }
}