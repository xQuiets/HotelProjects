@page "/user/bookings"
@rendermode InteractiveServer
@using HotelProject.Services
@using HotelProject.Models
@using HotelProject.Data
@using Microsoft.EntityFrameworkCore
@inject AuthService Auth
@inject NavigationManager Nav
@inject IDbContextFactory<AppDbContext> ContextFactory

<div style="display: flex; justify-content: flex-end; padding: 10px 20px;">
    <button @onclick="Logout" style="padding: 5px 15px;">Выйти</button>
</div>

<div style="text-align: center; padding: 10px;">
    <h3>Мои бронирования</h3>

    @if (bookings == null)
    {
        <p>Загрузка...</p>
    }
    else if (bookings.Count == 0)
    {
        <p style="color: red;">Данных нет</p>
    }
    else
    {
        <div style="display: flex; flex-direction: column; align-items: center; gap: 15px; margin-top: 20px;">
            @foreach (var booking in bookings)
            {
                <div style="border: 1px solid #111; padding: 15px; width: 100%; max-width: 500px; text-align: left;">
                    <div style="margin-bottom: 10px; font-weight: bold; font-size: 1.1em;">
                        Бронь @booking.BookingNumber
                    </div>

                    <div style="line-height: 1.6;">
                        <div>Организация: @booking.Organization?.Name</div>
                        <div>Контактное лицо: @booking.Contact</div>
                        <div>Дата заявки: @booking.DateRequest.ToString("dd.MM.yyyy")</div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Booking>? bookings;

    protected override async Task OnInitializedAsync()
    {
        using var context = await ContextFactory.CreateDbContextAsync();
        bookings = await context.Bookings
            .Include(b => b.Organization)
            .ToListAsync();
    }

    private async Task Logout()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/login");
    }
}